pragma solidity ^0.8.25;

import {Vm} from "forge-std-1.17.0/src/Vm.sol";
import {
    LibCodeGen,
    RAIN_COPYRIGHT_TEXT,
    RAIN_SPDX_LICENSE_IDENTIFIER
} from "rain-sol-codegen-0.1.39/src/lib/LibCodeGen.sol";
import {CloneNetwork} from "./LibRainDeployClone.sol";
import {LibRainDeploySnapshot} from "./LibRainDeploySnapshot.sol";

/// Thrown when a build would drop, change or reorder a network a release's extended networks record already holds.
/// @param suite The release's suite key.
/// @param index The position of the first recorded network the declaration does not hold unchanged.
error ExtendedNetworksRewritten(string suite, uint256 index);

/// Thrown when a release's declared extended networks are not exactly the ones its extended networks record holds,
/// or when extended networks are declared for a key with no tag, which has no record.
/// @param suite The release's suite key.
error ExtendedNetworksUnrecorded(string suite);

/// Thrown when an extended networks record is not exactly what the writer writes for the networks it holds, header
/// included, or holds no network, which the writer never writes.
/// @param path The record file.
error ExtendedNetworksUnreadable(string path);

/// @title LibRainDeployExtendedNetworks
/// @notice The generated, append-only record of the networks each per-network release is declared on beyond its
/// frozen record: `<root>/extended/<tag>/<name>.sol` for the release keyed by name `<name>` and tag `<tag>`. The
/// build writes it from `extendedNetworks`, refusing to drop or change an entry already written, and the broadcast and
/// the chain group refuse a declaration that is not exactly what it holds. So a declaration computed from anything
/// that later moves fails the build rather than moving the address, and the extension is published under the
/// generated tree with the rest of the record.
/// Append-only against the record in the checkout, not against its history: a commit that edits or deletes the record
/// and its declaration together passes the build, the broadcast and the chain group.
library LibRainDeployExtendedNetworks {
    /// The directory under the record root that holds the extended networks records.
    string constant EXTENDED_DIR = "extended";

    /// The line that ends the generated header; the record's body follows it.
    string constant HEADER_END = "// THIS FILE IS AUTOGENERATED BY THE BUILD SCRIPT. DO NOT EDIT BY HAND.\n";

    /// Where a release's extended networks record lives, or nothing for a key with no tag. Reverts with
    /// `InvalidRecordRoot` unless `<tag>/<name>` is a path of record root segments, which holds the record under `root`.
    /// @param root The record root — `LibRainDeploySnapshot.LIB_FS_ROOT` for a repo's real record.
    /// @param suite The release's suite key: its name, an at sign, then its tag.
    /// @return Whether the key is a release's, with a tag.
    /// @return The record's directory, empty when the key has no tag.
    /// @return The record's path, empty when the key has no tag.
    function extendedNetworksPath(string memory root, string memory suite)
        internal
        pure
        returns (bool, string memory, string memory)
    {
        LibRainDeploySnapshot.requireRecordRoot(root);
        bytes memory key = bytes(suite);
        uint256 at = 0;
        while (at < key.length && key[at] != "@") {
            at++;
        }
        bool tagged = at < key.length;
        if (!tagged) {
            return (tagged, "", "");
        }
        bytes memory name = new bytes(at);
        for (uint256 j = 0; j < at; j++) {
            name[j] = key[j];
        }
        bytes memory tag = new bytes(key.length - at - 1);
        for (uint256 j = 0; j < tag.length; j++) {
            tag[j] = key[at + 1 + j];
        }
        LibRainDeploySnapshot.requireRecordRoot(string.concat(string(tag), "/", string(name)));
        string memory dir = string.concat(root, "/", EXTENDED_DIR, "/", string(tag));
        return (tagged, dir, string.concat(dir, "/", string(name), ".sol"));
    }

    /// The body the writer writes below the header for a list of networks: each network's address, then its init
    /// data, in the list's order.
    /// @param vm The Vm instance for string operations.
    /// @param networks The networks.
    /// @return The body.
    function extendedNetworksBody(Vm vm, CloneNetwork[] memory networks) internal pure returns (string memory) {
        string memory body = "";
        for (uint256 i = 0; i < networks.length; i++) {
            string memory chainId = vm.toString(networks[i].chainId);
            body = string.concat(
                body,
                LibCodeGen.addressConstantString(
                    vm,
                    string.concat(
                        "/// @dev The deterministic deploy address of the EIP-1167 clone on chain id\n/// ",
                        chainId,
                        ", a network the release is declared on beyond its record."
                    ),
                    string.concat("DEPLOYED_ADDRESS_", chainId),
                    networks[i].deployedAddress
                ),
                LibCodeGen.bytesConstantString(
                    vm,
                    string.concat("/// @dev The init data the clone is broadcast with on chain id ", chainId, "."),
                    string.concat("INIT_DATA_", chainId),
                    networks[i].data
                )
            );
        }
        return body;
    }

    /// The networks a release's extended networks record holds, in its order, or none when there is no record.
    /// Reverts with `ExtendedNetworksUnreadable` unless the record is exactly what the writer writes for them.
    /// @param vm The Vm instance for file and string operations.
    /// @param root The record root.
    /// @param suite The release's suite key.
    /// @return The networks.
    function recordedExtendedNetworks(Vm vm, string memory root, string memory suite)
        internal
        view
        returns (CloneNetwork[] memory)
    {
        (bool tagged,, string memory path) = extendedNetworksPath(root, suite);
        if (!tagged || !vm.exists(path)) {
            return new CloneNetwork[](0);
        }
        string memory record = vm.readFile(path);
        string[] memory halves = vm.split(record, HEADER_END);
        if (halves.length != 2 || LibRainDeploySnapshot.hasForeignLineBreak(vm, record)) {
            revert ExtendedNetworksUnreadable(path);
        }
        checkExtendedNetworksHeader(vm, path, halves[0]);
        string[] memory entries = vm.split(halves[1], "DEPLOYED_ADDRESS_");
        CloneNetwork[] memory networks = new CloneNetwork[](entries.length - 1);
        for (uint256 i = 0; i < networks.length; i++) {
            networks[i] = recordedExtendedNetwork(vm, path, entries[i + 1]);
        }
        if (networks.length == 0 || keccak256(bytes(halves[1])) != keccak256(bytes(extendedNetworksBody(vm, networks))))
        {
            revert ExtendedNetworksUnreadable(path);
        }
        return networks;
    }

    /// Refuses an extended networks record's header, the text before `HEADER_END`, unless it is the writer's
    /// `LibCodeGen.filePrefix` for the licence and the copyright text its first two lines name.
    /// @param vm The Vm instance for string operations.
    /// @param path The record file, for the error only.
    /// @param header The text before `HEADER_END`.
    function checkExtendedNetworksHeader(Vm vm, string memory path, string memory header) internal pure {
        // The writer's header is four lines then the empty text before `HEADER_END`.
        string[] memory lines = vm.split(header, "\n");
        if (lines.length != 5 || bytes(lines[4]).length != 0) {
            revert ExtendedNetworksUnreadable(path);
        }
        //REUSE-IgnoreStart
        string memory licence = vm.replace(lines[0], "// SPDX-License-Identifier: ", "");
        string memory copyright = vm.replace(lines[1], "// SPDX-FileCopyrightText: ", "");
        //REUSE-IgnoreEnd
        // Neither holds a line break, as `lines` is split on `\n` and the record holds no other, so empty is the one
        // value `filePrefix` would refuse.
        if (bytes(licence).length == 0 || bytes(copyright).length == 0) {
            revert ExtendedNetworksUnreadable(path);
        }
        // Each of the four lines must be the writer's for the licence and copyright text read from it.
        string[] memory written = vm.split(LibCodeGen.filePrefix(licence, copyright), "\n");
        for (uint256 i = 0; i < 4; i++) {
            if (keccak256(bytes(lines[i])) != keccak256(bytes(written[i]))) {
                revert ExtendedNetworksUnreadable(path);
            }
        }
    }

    /// One network of an extended networks record, read from what follows its `DEPLOYED_ADDRESS_`. Reverts with
    /// `ExtendedNetworksUnreadable` on a chain id, address or init data that does not parse. Otherwise read leniently:
    /// `recordedExtendedNetworks` holds the whole body to what the writer writes for what is read here.
    /// @param vm The Vm instance for string operations.
    /// @param path The record file, for the error only.
    /// @param entry The entry.
    /// @return The network.
    function recordedExtendedNetwork(Vm vm, string memory path, string memory entry)
        internal
        pure
        returns (CloneNetwork memory)
    {
        string[] memory named = vm.split(entry, " =");
        string[] memory wrapped = vm.split(entry, "address(");
        string[] memory opened = vm.split(entry, "hex\"");
        if (wrapped.length < 2 || opened.length < 2) {
            revert ExtendedNetworksUnreadable(path);
        }
        CloneNetwork memory network = CloneNetwork({chainId: 0, data: "", deployedAddress: address(0)});
        try vm.parseUint(named[0]) returns (uint256 chainId) {
            network.chainId = chainId;
        } catch {
            revert ExtendedNetworksUnreadable(path);
        }
        try vm.parseAddress(vm.split(wrapped[1], ")")[0]) returns (address deployedAddress) {
            network.deployedAddress = deployedAddress;
        } catch {
            revert ExtendedNetworksUnreadable(path);
        }
        try vm.parseBytes(string.concat("0x", vm.split(opened[1], "\"")[0])) returns (bytes memory data) {
            network.data = data;
        } catch {
            revert ExtendedNetworksUnreadable(path);
        }
        return network;
    }

    /// Whether two networks are the same entry: chain id, init data and address.
    /// @param a One network.
    /// @param b The other.
    /// @return Whether they are equal.
    function sameNetwork(CloneNetwork memory a, CloneNetwork memory b) internal pure returns (bool) {
        return
            a.chainId == b.chainId && a.deployedAddress == b.deployedAddress && keccak256(a.data) == keccak256(b.data);
    }

    /// Refuses a release's declared extended networks unless they are exactly the ones its record holds, in order.
    /// @param vm The Vm instance for file and string operations.
    /// @param root The record root.
    /// @param suite The release's suite key.
    /// @param declared The networks `extendedNetworks` declares for it.
    function checkExtendedNetworksRecorded(
        Vm vm,
        string memory root,
        string memory suite,
        CloneNetwork[] memory declared
    ) internal view {
        CloneNetwork[] memory recorded = recordedExtendedNetworks(vm, root, suite);
        if (recorded.length != declared.length) {
            revert ExtendedNetworksUnrecorded(suite);
        }
        for (uint256 i = 0; i < recorded.length; i++) {
            if (!sameNetwork(recorded[i], declared[i])) {
                revert ExtendedNetworksUnrecorded(suite);
            }
        }
    }

    /// Writes a release's extended networks record, appending to the one already written: every network it holds
    /// MUST be declared again, unchanged and in the same position, else `ExtendedNetworksRewritten`. Writes nothing
    /// when nothing is declared.
    /// @param vm The Vm instance for file and string operations.
    /// @param root The record root.
    /// @param suite The release's suite key.
    /// @param declared The networks `extendedNetworks` declares for it.
    /// @param spdxLicenseIdentifier The SPDX licence identifier the written record declares.
    /// @param copyrightText The copyright text the written record declares.
    function writeExtendedNetworks(
        Vm vm,
        string memory root,
        string memory suite,
        CloneNetwork[] memory declared,
        string memory spdxLicenseIdentifier,
        string memory copyrightText
    ) internal {
        CloneNetwork[] memory recorded = recordedExtendedNetworks(vm, root, suite);
        for (uint256 i = 0; i < recorded.length; i++) {
            if (i >= declared.length || !sameNetwork(recorded[i], declared[i])) {
                revert ExtendedNetworksRewritten(suite, i);
            }
        }
        if (declared.length == 0) {
            return;
        }
        (bool tagged, string memory dir, string memory path) = extendedNetworksPath(root, suite);
        if (!tagged) {
            revert ExtendedNetworksUnrecorded(suite);
        }
        //forge-lint: disable-next-line(unsafe-cheatcode)
        vm.createDir(dir, true);
        //forge-lint: disable-next-line(unsafe-cheatcode)
        vm.writeFile(
            path,
            string.concat(
                LibCodeGen.filePrefix(spdxLicenseIdentifier, copyrightText), extendedNetworksBody(vm, declared)
            )
        );
    }

    /// `writeExtendedNetworks` applied to `RAIN_SPDX_LICENSE_IDENTIFIER` and `RAIN_COPYRIGHT_TEXT`, for a repo this
    /// org owns.
    /// @param vm The Vm instance for file and string operations.
    /// @param root The record root.
    /// @param suite The release's suite key.
    /// @param declared The networks `extendedNetworks` declares for it.
    function writeExtendedNetworks(Vm vm, string memory root, string memory suite, CloneNetwork[] memory declared)
        internal
    {
        writeExtendedNetworks(vm, root, suite, declared, RAIN_SPDX_LICENSE_IDENTIFIER, RAIN_COPYRIGHT_TEXT);
    }
}
