pragma solidity =0.8.25;

import {Test, Vm} from "forge-std-1.17.0/src/Test.sol";
import {DeployCandidate} from "../../../src/abstract/RainDeploySuitesBase.sol";
import {ParameterisedContract, RegistryDeploySuites} from "../../../src/abstract/RegistryDeploySuites.sol";
import {LibRainDeploySnapshot} from "../../../src/lib/LibRainDeploySnapshot.sol";
import {LibReleasedSuitesAggregate} from "../../lib/LibReleasedSuitesAggregate.sol";
import {LibMemoryKV, MemoryKV, MemoryKVKey, MemoryKVVal} from "rain-lib-memkv-0.2.0/src/lib/LibMemoryKV.sol";

/// A rolling snapshot the released aggregate does not import.
/// @param name The snapshot.
error SnapshotNotInAggregate(string name);

/// A contract the aggregate imports with neither a rolling snapshot nor a
/// frozen record.
/// @param name The contract.
error DeclaredWithoutSnapshotOrRecord(string name);

/// A contract the aggregate imports more than once.
/// @param name The contract.
error DuplicateAggregateDeclaration(string name);

/// @title GeneratedSnapshotShapeTest
/// @notice What a generated deploy snapshot must look like, asserted against
/// the real generator's committed output.
///
/// THESE ASSERTIONS ARE THE SPECIFICATION. There is no second hand-written file
/// to compare against and therefore no question about that file's provenance:
/// "there is an `address` constant named `DEPLOYED_ADDRESS`" is stated here,
/// once, in test code, and checked against what `script/Build.sol` actually
/// emitted.
///
/// The check reads the compiler's AST rather than the source text, so it is
/// about the file's STRUCTURE and not its formatting. `forge build --ast`
/// writes the AST into the artifact JSON, and — usefully, since a snapshot
/// declares only file-level constants and no contract at all — foundry still
/// emits an artifact for such a file.
///
/// Values are deliberately not asserted. A solc or optimiser change moves every
/// literal without changing anything here, and a wrong literal is caught
/// immediately by the group 1 derivation checks in `RainDeployVerifySnapshot`.
///
/// EVERY rolling snapshot is checked, not the first one. The generator writes
/// one per contract this repo deploys, so a shape asserted about one of them is
/// a shape asserted about the generator only for as long as there is one; the
/// second contract is exactly where a hand edit lands unseen. The set comes
/// from the directory the generator writes to and is checked to be the same set
/// the declaration names, because a walk that found the wrong files is a loop
/// that passes while asserting nothing about the contracts this repo deploys.
contract GeneratedSnapshotShapeTest is RegistryDeploySuites, Test {
    /// A committed record holding two releases of `AddressRegistry`.
    string constant FIXTURE_RECORD_ROOT = "test/fixture-zoltu-record";

    using LibMemoryKV for MemoryKV;

    /// The generated-file header every snapshot carries.
    string constant GENERATED_HEADER = "// THIS FILE IS AUTOGENERATED BY THE BUILD SCRIPT. DO NOT EDIT BY HAND.";

    /// Every rolling snapshot the generator has written, by contract name.
    ///
    /// Read from the directory rather than listed here, so a contract added to
    /// the declaration is covered by these assertions without anybody
    /// remembering to add it — which is the failure mode a shape spec is least
    /// able to notice, since a file nobody checks looks exactly like a file
    /// that passes.
    /// @return One entry per snapshot, e.g. `ConfigRegistry`.
    function snapshotContractNames() internal view returns (string[] memory) {
        Vm.DirEntry[] memory entries = vm.readDir(LibRainDeploySnapshot.dirForSnapshot(LibRainDeploySnapshot.CANDIDATE));

        string[] memory names = new string[](entries.length);
        for (uint256 i = 0; i < entries.length; i++) {
            string[] memory components = vm.split(entries[i].path, "/");
            names[i] = vm.replace(components[components.length - 1], ".sol", "");
        }
        return names;
    }

    /// The artifact for one generated snapshot, which carries its AST.
    ///
    /// Found by the source path its AST records rather than built from the
    /// name. A snapshot shares its file name with the contract it describes, so
    /// forge disambiguates the two artifacts, and how it does that depends on
    /// what else compiles: a nested `out/candidate/` directory for
    /// `ConfigRegistry`, and a compiler-profile suffix inside the shared
    /// `out/TimelockController.sol/` for OpenZeppelin's `TimelockController`,
    /// whose 2000-runs build takes the unsuffixed name. Both directories are
    /// searched and the artifact whose AST is the snapshot's source is read.
    /// @param contractName The contract the snapshot describes.
    /// @return The artifact path.
    function artifactPath(string memory contractName) internal view returns (string memory) {
        string memory source = LibRainDeploySnapshot.pathForSnapshot(LibRainDeploySnapshot.CANDIDATE, contractName);
        string[2] memory dirs = [
            string.concat("out/", LibRainDeploySnapshot.CANDIDATE, "/", contractName, ".sol"),
            string.concat("out/", contractName, ".sol")
        ];
        for (uint256 i = 0; i < dirs.length; i++) {
            if (!vm.isDir(dirs[i])) {
                continue;
            }
            Vm.DirEntry[] memory entries = vm.readDir(dirs[i]);
            for (uint256 j = 0; j < entries.length; j++) {
                string memory json = vm.readFile(entries[j].path);
                if (
                    vm.keyExistsJson(json, "$.ast.absolutePath")
                        && keccak256(bytes(vm.parseJsonString(json, "$.ast.absolutePath"))) == keccak256(bytes(source))
                ) {
                    return entries[j].path;
                }
            }
        }
        revert(string.concat("no artifact carries the AST of ", source));
    }

    /// The node types of a generated snapshot's source unit, in file order.
    ///
    /// Indexed one at a time rather than with a `$.ast.nodes[*].nodeType`
    /// wildcard: foundry's JSON path support requires a path to resolve to
    /// exactly one value, so the wildcard is rejected outright.
    /// @param contractName The contract the snapshot describes.
    /// @return One entry per top-level AST node.
    function nodeTypes(string memory contractName) internal view returns (string[] memory) {
        string memory json = vm.readFile(artifactPath(contractName));
        string[] memory found = new string[](64);
        uint256 count = 0;
        while (vm.keyExistsJson(json, string.concat("$.ast.nodes[", vm.toString(count), "].nodeType"))) {
            found[count] = vm.parseJsonString(json, string.concat("$.ast.nodes[", vm.toString(count), "].nodeType"));
            count++;
        }
        string[] memory types = new string[](count);
        for (uint256 i = 0; i < count; i++) {
            types[i] = found[i];
        }
        return types;
    }

    /// The declared constants of a generated snapshot, in file order, as
    /// `<type> <NAME>` — read from the AST, so formatting cannot affect it.
    /// @param contractName The contract the snapshot describes.
    /// @return One entry per file-level constant.
    function constantDeclarations(string memory contractName) internal view returns (string[] memory) {
        string memory json = vm.readFile(artifactPath(contractName));
        string[] memory types = nodeTypes(contractName);

        string[] memory found = new string[](types.length);
        uint256 count = 0;
        for (uint256 i = 0; i < types.length; i++) {
            if (keccak256(bytes(types[i])) != keccak256(bytes("VariableDeclaration"))) {
                continue;
            }
            string memory base = string.concat("$.ast.nodes[", vm.toString(i), "]");
            assertTrue(vm.parseJsonBool(json, string.concat(base, ".constant")), "snapshot declared a non-constant");
            found[count] = string.concat(
                vm.parseJsonString(json, string.concat(base, ".typeName.name")),
                " ",
                vm.parseJsonString(json, string.concat(base, ".name"))
            );
            count++;
        }
        string[] memory declarations = new string[](count);
        for (uint256 i = 0; i < count; i++) {
            declarations[i] = found[i];
        }
        return declarations;
    }

    /// The contract a candidate describes, taken from the `<path>:<Name>`
    /// artifact path it declares.
    ///
    /// That name is also the name of the candidate's rolling snapshot: the
    /// generator writes `src/generated/candidate/<Name>.sol`, and the
    /// declaration imports that exact file for its recorded creation code. A
    /// declaration and a generator that disagree about the name are a
    /// declaration whose snapshot is somebody else's.
    /// @param candidate The candidate to name.
    /// @return The contract name.
    function candidateContractName(DeployCandidate memory candidate) internal pure returns (string memory) {
        string[] memory components = vm.split(candidate.snapshot.artifactPath, ":");
        return components[components.length - 1];
    }

    /// Every rolling snapshot the walk found that is a deploy record — every
    /// one except the parameterised contracts' code records.
    /// @return One entry per deploy snapshot.
    function deploySnapshotNames() internal view returns (string[] memory) {
        string[] memory snapshots = snapshotContractNames();
        ParameterisedContract[] memory parameterised = parameterisedContracts();
        MemoryKV parameterisedSet = MemoryKV.wrap(0);
        for (uint256 i = 0; i < parameterised.length; i++) {
            parameterisedSet = parameterisedSet.set(
                MemoryKVKey.wrap(keccak256(bytes(parameterisedContractName(parameterised[i])))), MemoryKVVal.wrap(0)
            );
        }

        string[] memory found = new string[](snapshots.length);
        uint256 count = 0;
        for (uint256 i = 0; i < snapshots.length; i++) {
            if (!parameterisedSet.has(MemoryKVKey.wrap(keccak256(bytes(snapshots[i]))))) {
                found[count] = snapshots[i];
                count++;
            }
        }
        string[] memory names = new string[](count);
        for (uint256 i = 0; i < count; i++) {
            names[i] = found[i];
        }
        return names;
    }

    /// PROPERTY: the rolling snapshots and the declared contracts — the
    /// candidates and the parameterised contracts — are the same set, matched
    /// by name.
    ///
    /// Every other assertion here loops over the snapshots the walk found, and
    /// a loop over a short list passes. This is what says the list is neither
    /// short nor somebody else's: a declared contract with no rolling snapshot
    /// is a contract whose generated shape nothing below checks, and a snapshot
    /// with no declaration is a record of something this repo no longer
    /// declares.
    ///
    /// Matched by name in both directions rather than by counting, because
    /// equal counts are also what a missing snapshot and a stale one left
    /// behind together produce, and that is the pair a walk of a directory is
    /// most likely to find. The counts are asserted as well, so two
    /// declarations naming one contract cannot pass by both matching its single
    /// snapshot.
    function testEveryDeclaredContractHasASnapshot() external view {
        string[] memory snapshots = snapshotContractNames();
        DeployCandidate[] memory candidates = checkedCandidateSuites();
        ParameterisedContract[] memory parameterised = parameterisedContracts();

        string[] memory declared = new string[](candidates.length + parameterised.length);
        MemoryKV declaredSet = MemoryKV.wrap(0);
        for (uint256 i = 0; i < declared.length; i++) {
            declared[i] = i < candidates.length
                ? candidateContractName(candidates[i])
                : parameterisedContractName(parameterised[i - candidates.length]);
            declaredSet = declaredSet.set(MemoryKVKey.wrap(keccak256(bytes(declared[i]))), MemoryKVVal.wrap(0));
        }

        MemoryKV snapshotSet = MemoryKV.wrap(0);
        for (uint256 i = 0; i < snapshots.length; i++) {
            snapshotSet = snapshotSet.set(MemoryKVKey.wrap(keccak256(bytes(snapshots[i]))), MemoryKVVal.wrap(0));
        }

        assertEq(
            snapshots.length,
            declared.length,
            "a declared contract has no rolling snapshot, or a snapshot has no declaration"
        );

        for (uint256 i = 0; i < declared.length; i++) {
            assertTrue(
                snapshotSet.has(MemoryKVKey.wrap(keccak256(bytes(declared[i])))),
                string.concat("declared contract has no rolling snapshot: ", declared[i])
            );
        }

        for (uint256 i = 0; i < snapshots.length; i++) {
            assertTrue(
                declaredSet.has(MemoryKVKey.wrap(keccak256(bytes(snapshots[i])))),
                string.concat("rolling snapshot has no declaration: ", snapshots[i])
            );
        }
    }

    /// PROPERTY: every declared artifact path RESOLVES — it is `<path>:<Name>`,
    /// the path is a file this repo has, and the artifact that whole string
    /// selects is the contract the candidate is anchored to.
    ///
    /// `bytecode_hash = "none"` and `cbor_metadata = false` mean moving a file
    /// changes no creation code, no address and no code hash, so the path itself
    /// is the only thing that can be wrong about a path.
    ///
    /// Resolved through `vm.getCode`, which is foundry's own resolution of a
    /// `<path>:<Name>` artifact id — the same form `forge verify-contract`
    /// takes — rather than by searching the file's text for `contract <Name>`.
    /// A text search asserts formatting: it is satisfied by the name occurring
    /// in a comment or in a longer identifier, and defeated by a declaration
    /// written with no space before its brace.
    ///
    /// `vm.isFile` on the path half AS WELL, because `vm.getCode` resolves an
    /// artifact id by path SUFFIX while the printed command is run from the
    /// repo root. `concrete/ConfigRegistry.sol:ConfigRegistry` resolves for
    /// `vm.getCode` — uniquely, and to the right contract — and still names no
    /// file anybody can point `forge verify-contract` at. That is the one shape
    /// of wrong path nothing else in this repo goes red on.
    ///
    /// A path outside the `fs_permissions` roots fails here as a cheatcode
    /// revert naming the path rather than as this assertion's own message,
    /// which is foundry refusing to look rather than looking and not finding.
    ///
    /// Hashed rather than compared as bytes, for the reason
    /// `CandidateSourceMismatch` gives for hashing: creation codes run to tens
    /// of kilobytes, and a failure message carrying two of them is a failure
    /// message nobody reads.
    function testEveryCandidateArtifactPathResolves() external view {
        DeployCandidate[] memory candidates = checkedCandidateSuites();
        for (uint256 i = 0; i < candidates.length; i++) {
            string memory declared = candidates[i].snapshot.artifactPath;
            string[] memory parts = vm.split(declared, ":");

            assertEq(parts.length, 2, string.concat("artifact path is not <path>:<Name>: ", declared));
            assertTrue(vm.isFile(parts[0]), string.concat("artifact path names no such file: ", declared));
            assertEq(
                keccak256(vm.getCode(declared)),
                keccak256(candidates[i].snapshot.creationCode),
                string.concat("artifact path resolves to another contract: ", declared)
            );
        }
    }

    /// PROPERTY: the released aggregate declares every contract with a rolling
    /// deploy snapshot, plus retired contracts that have frozen records, each
    /// exactly once. A parameterised contract's code record is not a release
    /// and is not in the aggregate.
    ///
    /// `releasedSuites()` reads `src/lib/LibReleasedSuites.sol` and nothing
    /// else, so a contract missing from it has no declared release at all: its
    /// own `Lib<Contract>Released` compiles, is imported by nothing, is read by
    /// nothing, and the whole suite stays green for exactly as long as that
    /// contract has never been released. The release is when it lands —
    /// `cutRelease()` freezes every contract in the generated list, and
    /// `testEveryFrozenSnapshotIsReleased` then reverts on the frozen file that
    /// no released suite declares, during the release job, with the tag pushed
    /// and the deploy already broadcast.
    ///
    /// Generating the aggregate is what stops that being written. This is what
    /// stops it being LEFT — a hand-edited or stale aggregate is the same
    /// defect back — and it fails at the moment of the mistake instead of at
    /// the release.
    ///
    /// Matched against the rolling deploy snapshots rather than against a list here,
    /// because a list here would be one more place to add a contract to and
    /// that is the whole finding. `testEveryDeclaredContractHasASnapshot` above pins
    /// that same set to the declaration, so the two together run the chain from
    /// the declared candidates through the generator to what `releasedSuites()`
    /// returns.
    ///
    /// Both directions and no duplicates, for the reason the snapshot match
    /// gives: an aggregate that imports one contract twice and another not at
    /// all has the right number of imports, and a copied import line is how it
    /// happens.
    function testEverySnapshotIsInTheReleasedAggregate() external view {
        this.checkReleasedAggregate(
            LibReleasedSuitesAggregate.declaredContractNames(
                vm, vm.readFile(LibRainDeploySnapshot.pathForLib(LibRainDeploySnapshot.RELEASED_SUITES_LIBRARY))
            ),
            deploySnapshotNames(),
            LibRainDeploySnapshot.LIB_FS_ROOT
        );
    }

    /// The aggregate rule over any declaration, snapshot set and record root:
    /// every snapshot is declared, a declared contract with no snapshot is a
    /// retired one that has frozen records under `recordRoot`, and nothing is
    /// declared twice. External so the refusals can be expected.
    /// @param declared The contracts the aggregate imports.
    /// @param snapshots The rolling deploy snapshots.
    /// @param recordRoot The record root a retired contract's releases sit in.
    function checkReleasedAggregate(string[] memory declared, string[] memory snapshots, string memory recordRoot)
        external
        view
    {
        MemoryKV snapshotSet = MemoryKV.wrap(0);
        for (uint256 i = 0; i < snapshots.length; i++) {
            snapshotSet = snapshotSet.set(MemoryKVKey.wrap(keccak256(bytes(snapshots[i]))), MemoryKVVal.wrap(0));
        }

        MemoryKV declaredSet = MemoryKV.wrap(0);
        for (uint256 i = 0; i < declared.length; i++) {
            if (declaredSet.has(MemoryKVKey.wrap(keccak256(bytes(declared[i]))))) {
                revert DuplicateAggregateDeclaration(declared[i]);
            }
            declaredSet = declaredSet.set(MemoryKVKey.wrap(keccak256(bytes(declared[i]))), MemoryKVVal.wrap(0));
        }

        for (uint256 i = 0; i < snapshots.length; i++) {
            if (!declaredSet.has(MemoryKVKey.wrap(keccak256(bytes(snapshots[i]))))) {
                revert SnapshotNotInAggregate(snapshots[i]);
            }
        }

        for (uint256 i = 0; i < declared.length; i++) {
            if (!snapshotSet.has(MemoryKVKey.wrap(keccak256(bytes(declared[i]))))) {
                if (LibRainDeploySnapshot.recordPathsForContract(vm, recordRoot, declared[i]).length == 0) {
                    revert DeclaredWithoutSnapshotOrRecord(declared[i]);
                }
            }
        }
    }

    /// A retired contract with frozen records and a current one with a
    /// snapshot are both accepted.
    function testCheckReleasedAggregateAcceptsRetiredWithRecords() external view {
        string[] memory declared = new string[](2);
        declared[0] = "AddressRegistry";
        declared[1] = "Current";
        string[] memory snapshots = new string[](1);
        snapshots[0] = "Current";
        this.checkReleasedAggregate(declared, snapshots, FIXTURE_RECORD_ROOT);
    }

    /// A declared contract with neither a snapshot nor a record is refused.
    function testCheckReleasedAggregateRefusesDeclaredWithNothing() external {
        string[] memory declared = new string[](1);
        declared[0] = "NoSuchContract";
        vm.expectRevert(abi.encodeWithSelector(DeclaredWithoutSnapshotOrRecord.selector, "NoSuchContract"));
        this.checkReleasedAggregate(declared, new string[](0), FIXTURE_RECORD_ROOT);
    }

    /// A snapshot the aggregate does not import is refused.
    function testCheckReleasedAggregateRefusesAnUndeclaredSnapshot() external {
        string[] memory snapshots = new string[](1);
        snapshots[0] = "Current";
        vm.expectRevert(abi.encodeWithSelector(SnapshotNotInAggregate.selector, "Current"));
        this.checkReleasedAggregate(new string[](0), snapshots, FIXTURE_RECORD_ROOT);
    }

    /// A contract imported twice, as when one name is both retired and
    /// generated, is refused.
    function testCheckReleasedAggregateRefusesADuplicate() external {
        string[] memory declared = new string[](2);
        declared[0] = "Current";
        declared[1] = "Current";
        string[] memory snapshots = new string[](1);
        snapshots[0] = "Current";
        vm.expectRevert(abi.encodeWithSelector(DuplicateAggregateDeclaration.selector, "Current"));
        this.checkReleasedAggregate(declared, snapshots, FIXTURE_RECORD_ROOT);
    }

    /// A retired contract imported twice is refused too, though each copy has
    /// frozen records and the count would balance.
    function testCheckReleasedAggregateRefusesADuplicateRetired() external {
        string[] memory declared = new string[](2);
        declared[0] = "AddressRegistry";
        declared[1] = "AddressRegistry";
        vm.expectRevert(abi.encodeWithSelector(DuplicateAggregateDeclaration.selector, "AddressRegistry"));
        this.checkReleasedAggregate(declared, new string[](0), FIXTURE_RECORD_ROOT);
    }

    /// PROPERTY: every deploy snapshot declares exactly the five constants a deploy
    /// record is for, of these types, in this order. A rename, a retype, a
    /// reorder or a sixth constant each fail here and name what broke.
    ///
    /// `DEPENDENCIES` is `bytes` rather than `address[]` because Solidity has
    /// no file-scope constant of dynamic array type. It is the `abi.encode` of
    /// the list, which `releasedLibraryBlock` emits the `abi.decode` of — the
    /// type is a language constraint, so it is asserted here as one rather than
    /// left to look like a choice somebody could tidy up.
    function testSnapshotDeclaresTheFiveDeployConstantsInOrder() external view {
        string[] memory contractNames = deploySnapshotNames();
        for (uint256 i = 0; i < contractNames.length; i++) {
            string[] memory declarations = constantDeclarations(contractNames[i]);

            assertEq(declarations.length, 5, "snapshot declares an unexpected number of constants");
            assertEq(declarations[0], "bytes32 BYTECODE_HASH", "first constant is not bytes32 BYTECODE_HASH");
            assertEq(declarations[1], "address DEPLOYED_ADDRESS", "second constant is not address DEPLOYED_ADDRESS");
            assertEq(declarations[2], "bytes CREATION_CODE", "third constant is not bytes CREATION_CODE");
            assertEq(declarations[3], "bytes RUNTIME_CODE", "fourth constant is not bytes RUNTIME_CODE");
            assertEq(declarations[4], "bytes DEPENDENCIES", "fifth constant is not bytes DEPENDENCIES");
        }
    }

    /// PROPERTY: every parameterised contract's snapshot declares exactly the
    /// three code constants, of these types, in this order: no
    /// `DEPLOYED_ADDRESS`, because each constructor argument set deploys to its
    /// own address, and no `DEPENDENCIES`, because it is not broadcast as a
    /// suite.
    function testParameterisedSnapshotDeclaresTheThreeCodeConstantsInOrder() external view {
        ParameterisedContract[] memory parameterised = parameterisedContracts();
        for (uint256 i = 0; i < parameterised.length; i++) {
            string[] memory declarations = constantDeclarations(parameterisedContractName(parameterised[i]));

            assertEq(declarations.length, 3, "snapshot declares an unexpected number of constants");
            assertEq(declarations[0], "bytes32 BYTECODE_HASH", "first constant is not bytes32 BYTECODE_HASH");
            assertEq(declarations[1], "bytes CREATION_CODE", "second constant is not bytes CREATION_CODE");
            assertEq(declarations[2], "bytes RUNTIME_CODE", "third constant is not bytes RUNTIME_CODE");
        }
    }

    /// PROPERTY: every parameterised contract's artifact path is `<path>:<Name>`
    /// and resolves to compiled code.
    ///
    /// No `vm.isFile` on the path half, unlike a candidate: a parameterised
    /// contract is a dependency's, under `dependencies/`, outside the
    /// `fs_permissions` roots, and its path is not printed for
    /// `forge verify-contract`.
    function testEveryParameterisedArtifactPathResolves() external view {
        ParameterisedContract[] memory parameterised = parameterisedContracts();
        for (uint256 i = 0; i < parameterised.length; i++) {
            string memory declared = parameterised[i].artifactPath;
            string[] memory parts = vm.split(declared, ":");

            assertEq(parts.length, 2, string.concat("artifact path is not <path>:<Name>: ", declared));
            assertGt(vm.getCode(declared).length, 0, string.concat("artifact path resolves to no code: ", declared));
        }
    }

    /// PROPERTY: a snapshot imports nothing. It is read by repos that do not
    /// have the contract it describes — that is the whole reason a frozen
    /// release stays verifiable after its source has changed or gone — so any
    /// import would make it unusable to exactly the readers it exists for.
    function testSnapshotImportsNothing() external view {
        string[] memory contractNames = snapshotContractNames();
        for (uint256 i = 0; i < contractNames.length; i++) {
            string[] memory types = nodeTypes(contractNames[i]);
            for (uint256 j = 0; j < types.length; j++) {
                assertNotEq(types[j], "ImportDirective", "snapshot imports something");
            }
        }
    }

    /// PROPERTY: a snapshot declares no contract, library or interface. It is
    /// a record, not code; anything deployable in it would be a second
    /// definition of something the record is supposed to describe.
    function testSnapshotDeclaresNoContract() external view {
        string[] memory contractNames = snapshotContractNames();
        for (uint256 i = 0; i < contractNames.length; i++) {
            string[] memory types = nodeTypes(contractNames[i]);
            for (uint256 j = 0; j < types.length; j++) {
                assertNotEq(types[j], "ContractDefinition", "snapshot declares a contract");
            }
        }
    }

    /// PROPERTY: a snapshot says it is generated. Someone who opens it must
    /// be told not to hand-edit it, because hand-editing is how a deploy record
    /// stops describing the deployment.
    function testSnapshotSaysItIsGenerated() external view {
        string[] memory contractNames = snapshotContractNames();
        for (uint256 i = 0; i < contractNames.length; i++) {
            assertTrue(
                vm.contains(
                    vm.readFile(
                        LibRainDeploySnapshot.pathForSnapshot(LibRainDeploySnapshot.CANDIDATE, contractNames[i])
                    ),
                    GENERATED_HEADER
                ),
                "snapshot is missing the generated-file header"
            );
        }
    }
}
